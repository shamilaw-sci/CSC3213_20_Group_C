# Copy to frontend/.env.local and fill in. Never commit .env.local.

# Supabase: the same project as the backend. Use the anon key here, never the service_role key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional. Left unset, the app calls /api, which next.config.ts forwards to
# http://localhost:8000. Set it only if the backend runs somewhere else.
# NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Optional. true shows the TanStack Query devtools button (bottom right) under npm run dev.
# NEXT_PUBLIC_QUERY_DEVTOOLS=true
