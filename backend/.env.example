# Copy to backend/.env and fill in. Never commit backend/.env.

# --- Required ---------------------------------------------------------------
# Supabase: Project Settings > API (or ask the team for the shared project's values).
SUPABASE_URL=https://your-project.supabase.co
# The service_role key. It bypasses row-level security, so keep it on the server.
SUPABASE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# The backend will not start without this. Used for case triage and the assistant.
# A free Google AI Studio key works with the default endpoint and model below.
LLM_API_KEY=your-llm-api-key
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Leave unset for the default (gemini-3.5-flash-lite). gemini-3.5-flash is too
# slow on the free tier: chat questions time out.
# LLM_MODEL=gemini-3.5-flash-lite

# Where the frontend runs. Used for CORS and for links in emails.
PUBLIC_APP_URL=http://localhost:3000
# Extra allowed origins, comma-separated (e.g. http://127.0.0.1:3000).
# CORS_ORIGINS=

# --- Optional: everything works without these, just with less ------------
# OpenRouteService (road distances for dispatch); falls back to straight lines.
# ORS_API_KEY=

# Brevo (volunteer emails, donation thank-yous); without it, links are copied by hand.
# BREVO_API_KEY=
# BREVO_SENDER_EMAIL=
# BREVO_SENDER_NAME=Vets For Future

# PayHere sandbox (online donations). See backend/DONATION_SETUP.md.
# PAYHERE_MERCHANT_ID=
# PAYHERE_MERCHANT_SECRET=
# PAYHERE_APP_ID=
# PAYHERE_APP_SECRET=
# PUBLIC_API_URL=http://localhost:8000
